/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTTREE {
        ext.args = '-nocat'
    }

    withName: IQTREE {
        ext.args = '-m JC'
        tag = 'iqtree'
        publishDir = [
            path: { "${params.outdir}/iqtree" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename in ['iqtree.iqtree', 'iqtree.mldist', 'versions.yml']) {
                    null
                } else {
                    filename
                }
            }
        ]
    }

    withName: SNPDISTS_MATRIX {
        ext.args = ''
        ext.prefix = { "${meta.id}_SNP_Distances_Matrix" }
        tag = 'matrix'
        publishDir = [
            path: { "${params.outdir}/snpdists" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_matrix.tsv" : null }
        ]
    }

    withName: SNPDISTS_PAIRS {
        ext.args = '-m'
        ext.prefix = { "${meta.id}_SNP_Distances_Pairs" }
        tag = 'pairs'
        publishDir = [
            path: { "${params.outdir}/snpdists" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_pairs.tsv" : null }
        ]
    }

    withName: SNPDISTS_MATRIX_CFML {
        ext.args = '-k'
        ext.prefix = { "${meta.id}_SNP_Distances_Matrix" }
        tag = 'matrix'
        publishDir = [
            path: { "${params.outdir}/snpdists_clonalframeml" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_matrix.tsv" : null }
        ]
    }

    withName: SNPDISTS_PAIRS_CFML {
        ext.args = '-m -k'
        ext.prefix = { "${meta.id}_SNP_Distances_Pairs" }
        tag = 'pairs'
        publishDir = [
            path: { "${params.outdir}/snpdists_clonalframeml" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_pairs.tsv" : null }
        ]
    }

    withName: SNPDISTS_MATRIX_GUBBINS {
        ext.args = '-k'
        ext.prefix = { "${meta.id}_SNP_Distances_Matrix" }
        tag = 'matrix'
        publishDir = [
            path: { "${params.outdir}/snpdists_gubbins" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_matrix.tsv" : null }
        ]
    }

    withName: SNPDISTS_PAIRS_GUBBINS {
        ext.args = '-m -k'
        ext.prefix = { "${meta.id}_SNP_Distances_Pairs" }
        tag = 'pairs'
        publishDir = [
            path: { "${params.outdir}/snpdists_gubbins" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'snpdists.tsv' ? "snp_distances_pairs.tsv" : null }
        ]
    }

    withName: QUAST {
        ext.args = '--fast'
    }

    withName: SNPSITES {
        ext.args = '-c'
        publishDir = [
            path: { "${params.outdir}/snpsites" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'filtered_alignment.fas') {
                    'SNPs.fa'
                } else if (filename in ['variants.vcf', 'versions.yml'] || filename.endsWith('.sites.txt')) {
                    null
                } else {
                    filename
                }
            }
        ]
    }

   withName: GUBBINS {
       ext.args = '--model GTRCAT --recon-model GTRCAT'
       tag = 'gubbins'
       publishDir = [
           path: { "${params.outdir}/gubbins" },
           mode: params.publish_dir_mode,
           saveAs: { filename ->
               if (filename.toLowerCase() ==~ /.*\.(csv|embl|gff|vcf)$/) {
                   null
               } else {
                   filename
               }
           }
       ]
   }

   withName: CLONALFRAMEML {
       ext.prefix = 'cfml'
       tag = 'cfml'
   }

   withName: CLUSTER_CFML {
       publishDir = [
           path: { "${params.outdir}/cluster_clonalframeml" },
           mode: params.publish_dir_mode
       ]
   }

   withName: CLUSTER_GUBBINS {
       publishDir = [
           path: { "${params.outdir}/cluster_gubbins" },
           mode: params.publish_dir_mode
       ]
   }

    withName: GGTREE_CFML {
       publishDir = [
           path: { "${params.outdir}/ggtree_clonalframeml" },
           mode: params.publish_dir_mode
       ]
   }

    withName: GGTREE_GUBBINS {
       publishDir = [
           path: { "${params.outdir}/ggtree_gubbins" },
           mode: params.publish_dir_mode
       ]
   }

   withName: PATRISTICDISTANCE_CFML {
       publishDir = [
           path: { "${params.outdir}/patristicdistance_clonalframeml" },
           mode: params.publish_dir_mode,
           saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
       ]
   }

   withName: PATRISTICDISTANCE_GUBBINS {
       publishDir = [
           path: { "${params.outdir}/patristicdistance_gubbins" },
           mode: params.publish_dir_mode,
           saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
       ]
   }

}
